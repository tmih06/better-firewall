# /etc/default/bfirewall
#

# Set to yes to apply rules to support IPv6 (no means only IPv6 on loopback
# accepted). You will need to 'disable' and then 'enable' the firewall for
# the changes to take effect.
IPV6=yes

# Set the default input policy to ACCEPT, DROP, or REJECT. Please note that if
# you change this you will most likely want to adjust your rules.
DEFAULT_INPUT_POLICY="DROP"

# Set the default output policy to ACCEPT, DROP, or REJECT. Please note that if
# you change this you will most likely want to adjust your rules.
DEFAULT_OUTPUT_POLICY="ACCEPT"

# Set the default forward policy to ACCEPT, DROP or REJECT.  Please note that
# if you change this you will most likely want to adjust your rules
DEFAULT_FORWARD_POLICY="DROP"

# Set the default application policy to ACCEPT, DROP, REJECT or SKIP. Please
# note that setting this to ACCEPT may be a security risk. See 'man ufw' for
# details
DEFAULT_APPLICATION_POLICY="SKIP"

# bfirewall only ever touches its own tables; this key is accepted for
# ufw-config compatibility and ignored.
MANAGE_BUILTINS=no

# Logging backend: kernel (LOG) or netfilter (NFLOG).
LOGGING_BACKEND="kernel"

# The syslog level to use with kernel logging. One of: emerg, alert, crit,
# error, warning, notice, info or debug. Unset = kernel default (warning).
#KERNEL_SYSLOG_LEVEL="warning"

# Sysctl file applied on enable.
IPT_SYSCTL=/etc/bfirewall/sysctl.conf

# Extra connection tracking modules to load on enable.
IPT_MODULES=""
